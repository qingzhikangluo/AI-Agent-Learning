{
  "name": "ai-agent-rpg",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "AI Agent RPG - First Agent Vertical Slice (Monorepo Bootstrap)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli/*"
  ],
  "scripts": {
    "build": "node scripts/verify-repo.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint .",
    "lint:py": "python -m ruff check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:js && npm run test:ts && npm run test:py",
    "test:js": "node --test \"tests/*.test.mjs\"",
    "test:py": "python -m pytest",
    "test:ts": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
